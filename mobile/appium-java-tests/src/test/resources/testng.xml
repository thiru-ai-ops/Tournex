<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TourNex Appium Test Suite" parallel="classes" thread-count="1">
    <listeners>
        <listener class-name="com.tournex.tests.ExtentTestListener" />
    </listeners>
    
    <test name="E2E Integration and Scaled Parallel Tests">
        <packages>
            <package name="com.tournex.tests.authentication" />
            <package name="com.tournex.tests.navigation" />
            <package name="com.tournex.tests.profile" />
            <package name="com.tournex.tests.dashboard" />
            <package name="com.tournex.tests.search" />
            <package name="com.tournex.tests.settings" />
            <package name="com.tournex.tests.firebase" />
            <package name="com.tournex.tests.regression" />
        </packages>
    </test>
</suite>
